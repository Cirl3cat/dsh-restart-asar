{
  "name": "dsh-restart-asar",
  "version": "0.2.0",
  "description": "Restart entry for the DeepSeek Harness desktop shell, added by a byte-length-preserving app.asar patch: 重启 in the Windows caption menu and 重启 DeepSeek Harness in the system tray, with a restart that fully quits and cold-starts the app.",
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Cirl3cat",
  "homepage": "https://github.com/Cirl3cat/dsh-restart-asar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cirl3cat/dsh-restart-asar.git"
  },
  "bugs": {
    "url": "https://github.com/Cirl3cat/dsh-restart-asar/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "asar",
    "tray",
    "menu",
    "windows"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/patch.js",
    "lib/asar.js",
    "lib/patcher.mjs",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "docs/screenshots/app-menu.png",
    "docs/screenshots/tray-menu.png",
    "docs/screenshots/restart-confirm.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  }
}
